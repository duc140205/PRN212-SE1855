<Window x:Class="MyStoreWpfApp_EF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyStoreWpfApp_EF"
        mc:Ignorable="d"
        Title="Đăng nhập hệ thống" Height="400" Width="550" WindowStartupLocation="CenterScreen">
    <Grid>
        <Label Content="Đăng nhập hệ thống" HorizontalAlignment="Left" Margin="138,38,0,0" VerticalAlignment="Top" Width="144">
            <Label.Background>
                <LinearGradientBrush>
                    <GradientStop Color="Blue" Offset="0.0"></GradientStop>
                    <GradientStop Color="Red" Offset="0.5"></GradientStop>
                    <GradientStop Color="Yellow" Offset="1.0"></GradientStop>
                </LinearGradientBrush>
            </Label.Background>
        </Label>
        <Label Content="Email:" HorizontalAlignment="Left" Margin="102,98,0,0" VerticalAlignment="Top" Width="56"/>
        <TextBox x:Name="txtEmail" HorizontalAlignment="Left" Margin="185,103,0,0" TextWrapping="Wrap" Text="admin@CompanyName.com" VerticalAlignment="Top" Width="206" Height="21"/>
        <Label Content="Password:" HorizontalAlignment="Left" Margin="102,157,0,0" VerticalAlignment="Top" Width="73"/>
        <Button x:Name="btnDangNhap" Content="Đăng nhập" HorizontalAlignment="Left" Margin="185,217,0,0" VerticalAlignment="Top" Click="btnDangNhap_Click"/>
        <Button x:Name="btnThoat" Content="Thoát" HorizontalAlignment="Left" Margin="329,217,0,0" VerticalAlignment="Top" Width="62"/>
        <PasswordBox x:Name="txtPassword" HorizontalAlignment="Left" Margin="185,161,0,0" VerticalAlignment="Top" Width="206" Password="@1"/>

    </Grid>
</Window>
