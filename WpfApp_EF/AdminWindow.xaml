<Window x:Class="WpfApp_EF.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_EF"
        mc:Ignorable="d"
        Title="AdminWindow" Height="667" Width="908" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Height="50" Background="Yellow">
            <Label Content="Phần mềm quản lý MyStore" FontSize="30" HorizontalAlignment="Center"/>

        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Height="30" Background="Pink">
            <Label Content="Được thiết kế bởi: Ur Mom"/>

        </WrapPanel>

        <TreeView x:Name="tvCategory" DockPanel.Dock="Left" Background="Cyan" Width="350" SelectedItemChanged="tvCategory_SelectedItemChanged">

        </TreeView>

        <DockPanel Background="Red">
            <ListView DockPanel.Dock="Top" x:Name="lvProduct" d:ItemsSource="{d:SampleData ItemCount=5}" FontSize="20" Height="300" SelectionChanged="lvProduct_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Mã sản phẩm" DisplayMemberBinding="{Binding ProductId}" />
                        <GridViewColumn Header="Tên sản phẩm" DisplayMemberBinding="{Binding ProductName}" />
                        <GridViewColumn Header="Số lượng" DisplayMemberBinding="{Binding UnitsInStock}" />
                        <GridViewColumn Header="Giá" DisplayMemberBinding="{Binding UnitPrice}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Background="Beige">
                <Label Content="Mã sản phẩm:" HorizontalAlignment="Left" Margin="19,9,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtId" FontSize="20" HorizontalAlignment="Left" Margin="129,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="326"/>
                <Label Content="Tên sản phẩm:" HorizontalAlignment="Left" Margin="19,54,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtName" FontSize="20" HorizontalAlignment="Left" Margin="129,55,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="326"/>
                <Label Content="Số lượng:" HorizontalAlignment="Left" Margin="19,101,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtQuantity" FontSize="20" HorizontalAlignment="Left" Margin="129,102,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="326"/>
                <Label Content="Đơn giá:" HorizontalAlignment="Left" Margin="19,145,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtPrice" FontSize="20" HorizontalAlignment="Left" Margin="129,146,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="326"/>
                <Button x:Name="btnClear" Content="Clear" FontSize="20" HorizontalAlignment="Left" Margin="129,193,0,0" VerticalAlignment="Top" Click="btnClear_Click"/>
                <Button x:Name="btnUpdate" Content="Update" FontSize="20" HorizontalAlignment="Left" Margin="292,193,0,0" VerticalAlignment="Top" Click="btnUpdate_Click"/>
                <Button x:Name="btnDelete" Content="Delete" FontSize="20" HorizontalAlignment="Left" Margin="394,193,0,0" VerticalAlignment="Top" Click="btnDelete_Click"/>
                <Button x:Name="btnSave" Content="Save" FontSize="20" HorizontalAlignment="Left" Margin="213,193,0,0" VerticalAlignment="Top" Click="btnSave_Click"/>
            </Grid>
        </DockPanel>

    </DockPanel>
</Window>
