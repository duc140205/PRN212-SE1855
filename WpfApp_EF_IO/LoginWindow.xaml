<Window x:Class="WpfApp_EF_IO.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_EF_IO"
        mc:Ignorable="d"
        Title="Đăng nhập hệ thống" Height="450" Width="800">
    <Grid>
        <Label Content="Đăng nhập hệ thống" FontSize="30" HorizontalAlignment="Left" Margin="104,36,0,0" VerticalAlignment="Top"/>
        <Label Content="Email Adress:" FontSize="20" HorizontalAlignment="Left" Margin="91,117,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtEmail" FontSize="20" HorizontalAlignment="Center" Margin="0,121,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="332"/>
        <Label Content="Password:" FontSize="20" HorizontalAlignment="Left" Margin="91,190,0,0" VerticalAlignment="Top"/>
        <PasswordBox x:Name="txtPassword" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top" Width="332" Margin="0,194,0,0"/>
        <CheckBox x:Name="chkSaveInfor" FontSize="15" Content="Lưu thông tin đăng nhập" HorizontalAlignment="Left" Margin="234,254,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnLogin" Content="Đăng nhập" FontSize="20" HorizontalAlignment="Left" Margin="246,298,0,0" VerticalAlignment="Top" Click="btnLogin_Click" />
        <Button x:Name="btnThoat" Content="Thoát" FontSize="20" HorizontalAlignment="Left" Margin="503,298,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
